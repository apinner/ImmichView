# Copy to .env (git-ignored) and fill in. Never commit .env.
ROKU_HOST=192.168.x.x
ROKU_DEV_PASSWORD=

# Optional, for development: tools\relaunch.ps1 passes these to the channel so you
# don't have to re-enter them after each sideload (which clears the channel's settings).
IMMICH_URL=http://192.168.x.x:2283
IMMICH_API_KEY=
