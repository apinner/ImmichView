<?xml version="1.0" encoding="utf-8"?>
<!-- Plays one video asset with the standard Roku trick-play UI. Closes when it finishes. -->
<component name="VideoPlayer" extends="Group">
    <interface>
        <!-- { assetId, durationMs } -->
        <field id="asset" type="assocarray" onChange="onAssetSet" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <!-- Set when playback finished; MainScene closes the screen. -->
        <field id="done" type="boolean" alwaysNotify="true" />
        <!-- Set when the video first starts playing, or fails to (AppLaunchComplete after a deep link). -->
        <field id="playbackStarted" type="boolean" />
    </interface>

    <script type="text/brightscript" uri="VideoPlayer.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Api.brs" />

    <children>
        <Rectangle width="1920" height="1080" color="0x000000FF" />
        <Video id="video" width="1920" height="1080" enableUI="true" />
        <!-- A moment after playback starts: checks Roku found a video track it can decode. -->
        <Timer id="pictureCheck" duration="2" repeat="false" />
        <!-- Shown for a few seconds when a real-time (HLS) version plays: Roku gets no sound from it. -->
        <Group id="notice" translation="[80,60]" opacity="0">
            <Rectangle id="noticeBack" height="64" color="0x000000C0" />
            <Label id="noticeText" translation="[24,0]" height="64" vertAlign="center"
                font="font:SmallSystemFont" color="0xFFFFFFFF"
                text="No sound: Roku can't play the audio in Immich's real-time version of this video." />
        </Group>
        <Animation id="noticeAnim" duration="7" easeFunction="linear">
            <FloatFieldInterpolator key="[0.0, 0.08, 0.85, 1.0]" keyValue="[0.0, 1.0, 1.0, 0.0]" fieldToInterp="notice.opacity" />
        </Animation>
        <Label id="error" translation="[260,420]" width="1400" wrap="true" horizAlign="center"
            font="font:MediumSystemFont" color="0xE0E4E8FF" visible="false" />
    </children>
</component>
