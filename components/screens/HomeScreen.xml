<?xml version="1.0" encoding="utf-8"?>
<!-- Home: Photos (library timeline), Albums, People, Places and Search tabs. -->
<component name="HomeScreen" extends="Group">
    <interface>
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <!-- Set once the Photos tab shows photos or a message (for the AppLaunchComplete beacon). -->
        <field id="ready" type="boolean" />
        <!-- Set after switching user from the top bar; MainScene reloads. -->
        <field id="profilesChanged" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="HomeScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Api.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Settings.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Format.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Navigation.brs" />

    <children>
        <AppTitle translation="[80,28]" />
        <!-- Top-right: "* Options" hint (plus "Jump to date" on the Photos tab), user pill (fast switching) and settings gear.
             Up from the tabs reaches the pills; positioned by layoutTopBar(). -->
        <Label id="optionsHint" width="640" height="56" horizAlign="right" vertAlign="center"
            font="font:SmallSystemFont" color="0x80888FFF" text="&#x2190;  Jump to date        *  Options" />
        <IconPill id="userPill" icon="pkg:/images/icon-person.png" trailingIcon="pkg:/images/icon-chevron.png" />
        <IconPill id="gearPill" icon="pkg:/images/icon-gear.png" />

        <TabBar id="tabs" translation="[80,116]" />

        <TimelineView id="timeline" translation="[80,200]" viewHeight="866"
            emptyText="No photos in your library yet." />

        <Group id="albumsPane" visible="false">
            <!-- 5 x 328 + 4 x 30 = 1760 wide -->
            <MarkupGrid id="albums" translation="[80,216]" itemComponentName="AlbumTile"
                numColumns="5" numRows="3" itemSize="[328,272]" itemSpacing="[30,16]"
                vertFocusAnimationStyle="floatingFocus"
                focusBitmapUri="pkg:/images/focus.9.png" drawFocusFeedbackOnTop="true" />
            <Label id="albumStatus" translation="[160,460]" width="1600" wrap="true" horizAlign="center"
                font="font:MediumSystemFont" color="0xE0E4E8FF" />
        </Group>

        <PeoplePane id="peoplePane" visible="false" />

        <Group id="placesPane" visible="false">
            <MarkupGrid id="places" translation="[80,216]" itemComponentName="AlbumTile"
                numColumns="5" numRows="3" itemSize="[328,272]" itemSpacing="[30,16]"
                vertFocusAnimationStyle="floatingFocus"
                focusBitmapUri="pkg:/images/focus.9.png" drawFocusFeedbackOnTop="true" />
            <Label id="placeStatus" translation="[160,460]" width="1600" wrap="true" horizAlign="center"
                font="font:MediumSystemFont" color="0xE0E4E8FF" />
        </Group>
        <SearchPane id="searchPane" visible="false" />

        <Label id="status" translation="[160,460]" width="1600" wrap="true" horizAlign="center"
            font="font:MediumSystemFont" color="0xE0E4E8FF" />
    </children>
</component>
