<?xml version="1.0" encoding="utf-8"?>
<!-- Server URL + API key entry and connection check. First run, and "Add user" in Settings. -->
<component name="LoginScreen" extends="Group">
    <interface>
        <!-- Set after a successful check: { name, email, serverVersion } -->
        <field id="connectedUser" type="assocarray" />
    </interface>

    <script type="text/brightscript" uri="LoginScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Settings.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Api.brs" />

    <children>
        <AppTitle translation="[160,104]" />
        <Label id="subtitle" text="Connect to your Immich server" translation="[160,200]"
            font="font:MediumSystemFont" color="0xA0A8B0FF" />

        <MarkupList itemComponentName="ListItem" drawFocusFeedback="false" id="menu" translation="[160,300]" itemSize="[1200,72]" itemSpacing="[0,12]"
            numRows="3" vertFocusAnimationStyle="floatingFocus"
            />

        <Label id="status" translation="[160,620]" width="1600" wrap="true"
            font="font:MediumSystemFont" color="0xE0E4E8FF" />

        <Label id="hint" translation="[160,900]" width="1600" wrap="true"
            font="font:SmallSystemFont" color="0x80888FFF"
            text="Create an API key in the Immich web app under Account Settings > API Keys. The keyboard in the Roku mobile app makes typing it much easier." />
        <Label translation="[160,1010]" width="1600"
            font="font:SmallestSystemFont" color="0x6A6F7AFF"
            text="ImmichView is an unofficial app. It is not affiliated with or endorsed by Immich or FUTO." />
    </children>
</component>
