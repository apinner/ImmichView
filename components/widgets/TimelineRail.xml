<?xml version="1.0" encoding="utf-8"?>
<!--
    Timeline scrubber down the left of a photo grid (like the Immich web app's, which is on the
    right): year labels spaced by how many photos each period has; a thin semi-transparent
    lavender line marks the month on screen and its year is brighter.
    Focused (Left on the first photo of a row), a cursor steps month by month (Up/Down) or a
    year at a time (Rewind/Fast forward), repeating while held; OK sets chosen, Right or Back
    sets closed.
    Sits in the 80px left margin; the month label and hint draw over the grid.
-->
<component name="TimelineRail" extends="Group">
    <interface>
        <!-- [{ timeBucket, count }] in timeline order (TimelineView.months). -->
        <field id="months" type="array" onChange="onMonthsSet" />
        <!-- Month index on screen (TimelineView.monthIndex). -->
        <field id="current" type="integer" value="-1" onChange="updateCurrentYear" />
        <field id="railHeight" type="float" value="860" onChange="onMonthsSet" />
        <!-- Month index to start the cursor on when focused. -->
        <field id="cursor" type="integer" onChange="onCursorSet" />
        <field id="chosen" type="integer" alwaysNotify="true" />
        <field id="closed" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="TimelineRail.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Format.brs" />

    <children>
        <Rectangle id="line" translation="[45,0]" width="2" color="0x4A4960FF" />
        <!-- The month on screen: a thin, semi-transparent lavender line under its year label and
             across the rail, stopping short of the photos. -->
        <Rectangle id="marker" translation="[0,0]" width="50" height="3" color="0xC6A1E7A0" visible="false" />
        <!-- Both forms of each year label, crossfaded as the rail widens (focused) or narrows. -->
        <Group id="labels" translation="[-22,0]">
            <Group id="labelsShort" />
            <Group id="labelsLong" opacity="0" />
        </Group>

        <!-- While focused: the cursor's month in a lavender pill beside the rail, and the keys. -->
        <Group id="cursorGroup" visible="false">
            <!-- The cursor's place on the rail. -->
            <Poster uri="pkg:/images/circle-mask.png" translation="[62,-6]" width="12" height="12" blendColor="0xC6A1E7FF" />
            <Poster id="bubble" uri="pkg:/images/pill.9.png" blendColor="0xC6A1E7FF" translation="[76,-28]" height="56" />
            <Label id="bubbleText" translation="[98,-25]" height="56" vertAlign="center"
                font="font:SmallBoldSystemFont" color="0x24232FFF" />
        </Group>
        <!-- Eases the rail between narrow (resting, '26) and wide (focused, 2026). Key values are
             set when it starts, from wherever it is. -->
        <Animation id="resize" duration="0.3" easeFunction="inOutCubic">
            <Vector2DFieldInterpolator id="lineMove" key="[0.0, 1.0]" fieldToInterp="line.translation" />
            <Vector2DFieldInterpolator id="labelsMove" key="[0.0, 1.0]" fieldToInterp="labels.translation" />
            <FloatFieldInterpolator id="markerWidth" key="[0.0, 1.0]" fieldToInterp="marker.width" />
            <FloatFieldInterpolator id="shortFade" key="[0.0, 1.0]" fieldToInterp="labelsShort.opacity" />
            <FloatFieldInterpolator id="longFade" key="[0.0, 1.0]" fieldToInterp="labelsLong.opacity" />
        </Animation>
        <!-- Holding Up/Down (or Rewind/Fast forward) keeps stepping until the key is released. -->
        <Timer id="holdTimer" repeat="true" duration="0.4" />
        <Group id="hint" visible="false">
            <Rectangle id="hintBack" width="1040" height="44" color="0x1C1B25E6" />
            <Label translation="[20,0]" height="44" vertAlign="center" font="font:SmallestSystemFont" color="0xA0A8B0FF"
                text="Up / Down  month      Rewind / Fast forward  year      OK  go      Right  back" />
        </Group>
    </children>
</component>
