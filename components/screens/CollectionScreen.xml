<?xml version="1.0" encoding="utf-8"?>
<!-- A titled set of photos grouped by month: an album, a person, or a place. -->
<component name="CollectionScreen" extends="Group">
    <interface>
        <!-- { title, query } where query selects timeline buckets, e.g. "albumId=...&order=desc",
             or { title, subtitle, search } for a place, where search is a metadata search filter
             such as { city, state, country }. -->
        <field id="source" type="assocarray" onChange="onSourceSet" />
        <field id="navigate" type="assocarray" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="CollectionScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Format.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Navigation.brs" />

    <children>
        <Label id="title" translation="[80,48]" width="1340" height="72"
            font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />
        <Label id="count" translation="[80,122]" width="800"
            font="font:SmallSystemFont" color="0x80888FFF" />
        <Label id="hint" translation="[1200,56]" width="640" height="56" horizAlign="right" vertAlign="center"
            font="font:SmallSystemFont" color="0x80888FFF" text="*  Options" />

        <TimelineView id="timeline" translation="[80,170]" viewHeight="890" emptyText="Nothing here yet." />
        <!-- Timeline scrubber in the left margin (albums and people; places have no month list). -->
        <TimelineRail id="rail" translation="[0,170]" railHeight="890" visible="false" />
    </children>
</component>
