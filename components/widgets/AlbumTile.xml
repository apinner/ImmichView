<?xml version="1.0" encoding="utf-8"?>
<!-- Album grid item: cover, name and item count. -->
<component name="AlbumTile" extends="Group">
    <interface>
        <field id="itemContent" type="node" onChange="onContentChanged" />
    </interface>

    <script type="text/brightscript" uri="AlbumTile.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Api.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Format.brs" />

    <children>
        <Rectangle width="328" height="205" color="0x2E2D3AFF" />
        <Poster id="cover" width="328" height="205" loadWidth="328" loadHeight="205"
            loadDisplayMode="scaleToZoom" />
        <Label id="name" translation="[0,212]" width="328" height="34"
            font="font:SmallBoldSystemFont" color="0xE0E4E8FF" />
        <Label id="count" translation="[0,246]" width="328" height="26"
            font="font:SmallestSystemFont" color="0x80888FFF" />
    </children>
</component>
