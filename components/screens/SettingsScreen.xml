<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: switch, add and remove users; slideshow speed; people's names; options for the ImmichView Screensaver app (photos, caption, clock). -->
<component name="SettingsScreen" extends="Group">
    <interface>
        <field id="navigate" type="assocarray" alwaysNotify="true" />
        <!-- Set when the active user changed or was removed; MainScene reloads. -->
        <field id="profilesChanged" type="boolean" alwaysNotify="true" />
    </interface>

    <script type="text/brightscript" uri="SettingsScreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Log.brs" />
    <script type="text/brightscript" uri="pkg:/source/common/Settings.brs" />

    <children>
        <Label text="Settings" translation="[160,80]" font="font:LargeBoldSystemFont" color="0xFFFFFFFF" />

        <Label text="Users" translation="[160,180]" font="font:MediumBoldSystemFont" color="0xE0E4E8FF" />
        <MarkupList itemComponentName="ListItem" drawFocusFeedback="false" id="users" translation="[160,256]" itemSize="[1200,72]" itemSpacing="[0,12]"
            numRows="3" vertFocusAnimationStyle="floatingFocus"
            />

        <Label text="Photos, slideshow and ImmichView Screensaver" translation="[160,548]" font="font:MediumBoldSystemFont" color="0xE0E4E8FF" />
        <MarkupList itemComponentName="ListItem" drawFocusFeedback="false" id="options" translation="[160,620]" itemSize="[1200,72]" itemSpacing="[0,12]"
            numRows="4" vertFocusAnimationStyle="floatingFocus"
            />

        <Label id="hint" translation="[160,984]" width="1600"
            font="font:SmallSystemFont" color="0x80888FFF" />
        <Label id="about" translation="[160,1030]" width="1600"
            font="font:SmallestSystemFont" color="0x6A6F7AFF" />
    </children>
</component>
